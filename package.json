{
  "name": "@lonjonn/fallible",
  "version": "0.1.2",
  "packageManager": "pnpm@10.8.1",
  "description": "A simple, type-safe, and composable way to handle errors in TypeScript",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/lonjonn/fallible#readme",
  "bugs": {
    "url": "https://github.com/lonjonn/fallible/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonjonn/fallible.git"
  },
  "author": "Leon Salsiccia <leon.salsiccia@gmail.com>",
  "funding": {
    "url": "https://github.com/sponsors/lonjonn"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "bumpp": "^10.1.0",
    "prettier": "^3.5.3",
    "tsdown": "^0.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "prettier": {
    "printWidth": 120,
    "quoteProps": "consistent"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [
    "result",
    "typescript",
    "type-safe",
    "error",
    "error handling"
  ]
}
